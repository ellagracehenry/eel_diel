SIR_hazard_submodel <- function(data, lambda_emerge, lambda_hide){
  individual_ID <- data$individual_ID #get individual IDs out
  N <- length(individual_ID) #count how many individuals
  T <- ncol(data)-1 #count how many time steps to simulate
  
  a_threshold <- rep(1,N) #define an activation threshold of 1
  tm <- 5 #define a memory limit of 5 seconds
  positions <- data.frame("x" = rnorm(N,2,1),"y"=rnorm(N,2,1)) #for now, randomly simulate eel positions
  df_agents <- data.frame(individual_ID, a_threshold, positions) #Individual ID parameter store
  
  state_record = matrix(NA, nrow = N, ncol = T) #Assign NAs for state_record table
  states = sample(c(0,1), N, replace = TRUE) #Randomly assign initial states
  state_record[,1]  <- states #Add initial states to the state_record table
  
  startled_matrix <- matrix(FALSE, nrow=N, ncol=T) #Initialise startle table as false for all individuals
  activation_matrix <- matrix(0, nrow=N, ncol=T) #Initialise startle table as false for all individuals
  time_in_state_matrix <- matrix(1, nrow = N, ncol = 1) #Initialise time in state matrix as 1 for all individuals
  
  w <- matrix(1, nrow=N, ncol=N) #Link strength matrix
  
  for(t in 1:(T-1)) { #for each time step
    for (i in 1:N){ #for each individual
      current_state <- state_record[i,t] #current state
      alternate_state <- ifelse((1-current_state == 1), 1, 0) #alternate state
      
      # #time in current state 
      # count <- 0
      # for (k in t:1) {
      #   if (state_record[i,t] == current_state) {
      #     time_in_current_state <- count + 1
      #   } else {
      #     break
      #   }
      # }
      
      K <- sum(state_record[,t]) #number of emerged individuals
      
      if (current_state == 1) { #if individual is emerged 
        activation_result <- activation_function(i, startled_matrix, w, t, tm, df_agents$a_threshold[i],K) #is it activated by social cues
        if (activation_result == 1) { #if not activated (stays emerged)
          p_hide <- exp_hazard_function(lambda_hide,time_in_state_matrix[i,1]) #calculate probability of spontaneous hide due to satiation
          if (rbinom(1,1,p_hide) == 1) { #binomial draw for spontaneous hide, if success
            new_state <- 0 #hide
            time_in_state_matrix[i,1] <- 0 #time in state matrix reset
          } else { #if failure
            new_state <- 1 #stay emerged 
            time_in_state_matrix[i,1] <- time_in_state_matrix[i,1] + 1 #+1 to time in state matrix
          }
        } else { #if activated (hides)
          new_state <- 0 #hide
          time_in_state_matrix[i,1] <- 0 #time in state matrix reset
        }
      } else { #if individual is hidden
        p_emerge <- exp_hazard_function(lambda_emerge, time_in_state_matrix[i,1]) #calculate probability of spontaneous emerge due to satiation
        if (rbinom(1,1,p_emerge) == 1) { #binomial draw for spontaneous emerge
          new_state <- 1 #emerge
          time_in_state_matrix[i,1] <- 0 #time in state matrix reset
        } else {
          new_state <- 0 #stay hidden
          time_in_state_matrix[i,1] <- time_in_state_matrix[i,1] + 1 #+1 to time in state matrix
        }
      
      }
      
      state_record[i,t+1] <- new_state #update state record
      activation_matrix[i,t+1] <- activation_result #store activation result
      
      if (new_state != current_state && new_state == 0) { #if state change and was a hide
          startled_matrix[i, t+1] <- TRUE #update startle matrix as true
          }
    }
  }
  
  state_record <- cbind(individual_ID = data$individual_ID, state_record)
  
  df_state <- as.data.frame(state_record)
  
  df_long <- melt(df_state, id.vars = "individual_ID")
  df_long$variable <- as.numeric(df_long$variable)
  
  
  return(df_long)
  
}
